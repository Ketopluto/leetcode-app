# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.

# --- Core (required) ---
# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the /admin login (HoD access). Choose a strong, unique value.
HOD_PASSWORD=

# --- Database ---
# Postgres connection string (e.g. Supabase). If unset, falls back to local SQLite.
DATABASE_URL=

# --- Local development ---
# Set to "development" to allow SECRET_KEY/HOD_PASSWORD to be auto-generated
# for local runs. Never set this in production.
FLASK_ENV=development

# --- Email (weekly reports to HoD) ---
# All four must be set for email sending to be enabled.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
HOD_EMAIL=
# Optional: defaults to SMTP_USERNAME if unset
FROM_EMAIL=

# --- Scheduler ---
# Minutes between automatic stats refreshes (local/traditional hosting only;
# has no effect on Vercel, which uses the cron endpoints below instead).
STATS_REFRESH_INTERVAL=30

# --- Vercel serverless cron endpoints ---
# Shared secret required by /api/cron/weekly-reports and /api/cron/refresh-stats
# (call them with ?secret=<CRON_SECRET>). Leave unset only for local testing.
CRON_SECRET=

# --- Deployment platform detection (set automatically by Vercel, don't set manually) ---
# VERCEL=1
